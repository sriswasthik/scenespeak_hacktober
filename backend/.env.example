# Server Configuration
PORT=5000

# Google GenAI API Key (Required for Gemma / Gemini multimodal inference)
# Obtain your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection:
# Uses Gemma 4 / multimodal Gemma or Gemini models supported in Gemini API:
# Recommended options: 'gemini-2.5-flash' (fastest & best multimodal reasoning),
# 'gemini-1.5-flash', or 'gemma-3-27b-it'
GEMMA_MODEL=gemini-3.8-flash

# Maximum upload file size in megabytes
MAX_FILE_SIZE_MB=10
